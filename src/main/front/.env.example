# TravelMate 프론트엔드 환경변수 설정
# 이 파일을 .env로 복사한 뒤 필요한 값을 입력합니다.
# .env 파일은 Git에 커밋하지 않습니다.

# 네이버 지도 API
REACT_APP_NAVER_MAP_CLIENT_ID=

# 백엔드 API 주소 (선택)
# 로컬 개발: http://localhost:8080
# REACT_APP_API_BASE=

# 참고
# REACT_APP_* 환경변수는 React 빌드 시점에 적용됩니다.
# 환경변수를 변경한 경우 프론트엔드를 다시 빌드해야 합니다.
# Client Secret 등 비밀 정보는 프론트엔드에 저장하지 않습니다.