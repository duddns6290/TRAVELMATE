# TravelMate 백엔드 환경변수 설정
# 이 파일을 .env로 복사한 뒤 실행 환경에 맞는 값을 입력합니다.
# 실제 .env 파일은 Git에 커밋하지 않습니다.

# MySQL
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# MongoDB
SPRING_DATA_MONGODB_URI=

# JWT
JWT_SECRET=

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# OAuth2 - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
NAVER_SCOPE=

# OAuth2 - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_SCOPE=

# 외부 API
GOOGLE_PLACES_API_KEY=
SK_API_KEY=
TOUR_API_KEY=
WEATHER_API_KEY=
YOUTUBE_API_KEY=

# CORS
# 허용할 프론트엔드 주소를 쉼표로 구분하여 입력합니다.
CORS_ALLOWED_ORIGINS=

# 참고
# 환경변수는 실행 환경에 맞게 설정해야 합니다.
# 비밀번호, JWT Secret, API Secret 등 민감한 값은 Git에 커밋하지 않습니다.
# Docker 배포에서는 백엔드 컨테이너에 환경변수를 전달해야 합니다.